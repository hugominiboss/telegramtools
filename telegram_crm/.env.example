# BotCashGain v1.0 — banco de dados
# Para desenvolvimento local use SQLite (não exige Postgres instalado):
DATABASE_URL=sqlite:///./botcashgain.db

# Para VPS/Postgres, comente a linha acima e descomente o bloco abaixo:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=postgres
# DB_NAME=telegram_crm

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Pool de proxies SOCKS5 (separado por vírgula).
# Se vazio, usa o proxy padrão WebShare rotativo.
PROXIES=
